{
  "name": "angular-food-facts",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "dev": "ng serve",
    "build": "ng build",
    "build:prod": "ng build --configuration production",
    "build:perf": "ng build --configuration production --base-href /angular/ --output-path ../perf-dist/angular-temp && mv ../perf-dist/angular-temp/browser ../perf-dist/angular && rm -rf ../perf-dist/angular-temp",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "echo 'Angular linting not configured yet'",
    "clean": "rm -rf dist node_modules/.cache"
  },
  "prettier": {
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^22.2.4",
    "@angular/compiler": "^22.2.4",
    "@angular/core": "^22.2.4",
    "@angular/forms": "^22.2.4",
    "@angular/platform-browser": "^22.2.4",
    "@angular/router": "^22.2.4",
    "rxjs": "~7.8.2",
    "shared-types": "workspace:*",
    "tslib": "^2.9.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.5",
    "@angular/cli": "22.2.5",
    "@angular/compiler-cli": "^22.2.4",
    "@types/jasmine": "~5.1.0",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "~5.7.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~6.0.3"
  }
}
