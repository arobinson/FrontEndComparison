{
  "name": "frontend-framework-comparison",
  "version": "1.0.0",
  "description": "Performance and bundle size comparison across Angular, React, Svelte, SolidJS, Lit, Vue, and Preact",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.1.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.22.2",
      "onFail": "download"
    }
  },
  "scripts": {
    "install:all": "pnpm install",
    "build:all": "pnpm -r build",
    "build:angular": "pnpm --filter AngularFoodFacts build",
    "build:react": "pnpm --filter ReactFoodFacts build",
    "build:svelte": "pnpm --filter SvelteFoodFacts build",
    "build:solid": "pnpm --filter SolidFoodFacts build",
    "build:lit": "pnpm --filter LitFoodFacts build",
    "build:vue": "pnpm --filter vue-food-facts build",
    "build:preact": "pnpm --filter preact-food-facts build",
    "dev:angular": "pnpm --filter AngularFoodFacts dev",
    "dev:react": "pnpm --filter ReactFoodFacts dev",
    "dev:svelte": "pnpm --filter SvelteFoodFacts dev",
    "dev:solid": "pnpm --filter SolidFoodFacts dev",
    "dev:lit": "pnpm --filter LitFoodFacts dev",
    "dev:vue": "pnpm --filter vue-food-facts dev",
    "dev:preact": "pnpm --filter preact-food-facts dev",
    "test:all": "pnpm -r test",
    "test:angular": "pnpm --filter AngularFoodFacts test",
    "test:react": "pnpm --filter ReactFoodFacts test",
    "test:svelte": "pnpm --filter SvelteFoodFacts test",
    "test:solid": "pnpm --filter SolidFoodFacts test",
    "performance:test": "node performance-tests/run-all.js",
    "performance:angular": "node performance-tests/run-single.js --framework=angular",
    "performance:react": "node performance-tests/run-single.js --framework=react",
    "performance:svelte": "node performance-tests/run-single.js --framework=svelte",
    "performance:solid": "node performance-tests/run-single.js --framework=solid",
    "performance:lit": "node performance-tests/run-single.js --framework=lit",
    "benchmark:dev-startup": "node performance-tests/dev-server-benchmark.js",
    "generate:charts": "node performance-tests/generate-charts.js",
    "generate:blog": "node performance-tests/generate-blog-report.js",
    "perf:build": "rm -rf perf-dist && mkdir perf-dist && cp perf-serve.json perf-dist/serve.json && pnpm --filter angular-food-facts build:perf && pnpm --filter react-food-facts build:perf && pnpm --filter svelte-food-facts build:perf && pnpm --filter solid-food-facts build:perf && pnpm --filter lit-food-facts build:perf && pnpm --filter vue-food-facts build:perf && pnpm --filter preact-food-facts build:perf",
    "perf:serve": "serve perf-dist -l 8888",
    "perf:build:serve": "pnpm run perf:build && pnpm run perf:serve",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "pnpm -r lint",
    "clean": "pnpm -r clean && rm -rf node_modules"
  },
  "workspaces": [
    "shared-types",
    "AngularFoodFacts",
    "ReactFoodFacts",
    "SvelteFoodFacts",
    "SolidFoodFacts",
    "LitFoodFacts",
    "VueFoodFacts",
    "PreactFoodFacts",
    "performance-tests"
  ],
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.57.0",
    "prettier": "^3.2.0",
    "puppeteer": "^21.0.0",
    "serve": "^14.2.6",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=24.15.0",
    "pnpm": ">=12.0.0"
  },
  "keywords": [
    "frontend",
    "framework",
    "performance",
    "benchmark",
    "angular",
    "react",
    "svelte",
    "solidjs",
    "lit",
    "vue",
    "preact"
  ],
  "author": "",
  "license": "MIT"
}
